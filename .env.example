# Copy to .env and fill in. Never commit .env.
LB_ENVIRONMENT=production
LB_DOMAIN=leads.example.com
POSTGRES_PASSWORD=change-me
LB_SECRET_KEY=generate-a-long-random-string

# Operator identity: fills the report and the email footer. Missing values block sending.
LB_OPERATOR_NAME=
LB_OPERATOR_PHONE=
LB_OPERATOR_ADDRESS=
LB_OPERATOR_EMAIL=

# Crawler identity and manners
LB_USER_AGENT=LeadBeastBot/1.0 (+mailto:you@example.com)
LB_DAILY_REQUEST_CAP_PER_HOST=500
LB_MONTHLY_CAP_CENTS=3000

# Email (Amazon SES SMTP or any relay). Credentials are read by reference.
LB_SMTP_HOST=
LB_SMTP_PORT=587
LB_SENDER_EMAIL=
LB_SMTP_USER=
LB_SMTP_PASSWORD=
LB_UNSUBSCRIBE_BASE_URL=https://leads.example.com/u
LB_PUBLIC_BASE_URL=https://leads.example.com

# Optional adapters
LB_OLLAMA_URL=http://ollama:11434
LB_OLLAMA_MODEL=llama3.1:8b
LB_ESPOCRM_URL=
LB_ESPOCRM_API_KEY=

# API token hash from `leadbeast user token`
LB_API_TOKEN_HASH=
